generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by Prisma Migrate / db push; set to the direct (non-pooler) Supabase URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  name           String?
  supabaseUserId String?     @unique
  createdAt      DateTime    @default(now())
  workspaces     Workspace[]
}

model Workspace {
  id        String           @id @default(cuid())
  name      String
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  settings  HuntSettings?
  hunts     Hunt[]
  listings  TrackedListing[]
  createdAt DateTime         @default(now())
}

/// One row per workspace. All money in minor units (cents).
model HuntSettings {
  id                      String    @id @default(cuid())
  workspaceId             String    @unique
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  minSold30d              Int       @default(20)
  minAeRating             Float     @default(4.7)
  minAeReviews            Int       @default(20)
  minAeOrders             Int       @default(50)
  minMatchConfidence      Int       @default(70)
  minMarginPct            Float     @default(10)
  ebayFeeRate             Float     @default(0.1325)
  aeShippingEstimateMinor Int       @default(300)
  extraCostMinor          Int       @default(0)
  minEbayPriceMinor       Int       @default(800)
  maxEbayPriceMinor       Int       @default(15000)
  updatedAt               DateTime  @updatedAt
}

model Hunt {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// KEYWORDS | TERAPEAK
  kind         String           @default("KEYWORDS")
  label        String
  /// JSON array: keywords (KEYWORDS) or parsed rows (TERAPEAK)
  payloadJson  String
  totalItems   Int
  /// Index of the next payload item to process
  cursor       Int              @default(0)
  /// RUNNING | COMPLETED | FAILED | CANCELLED
  status       String           @default("RUNNING")
  scannedCount Int              @default(0)
  trackedCount Int              @default(0)
  sourcedCount Int              @default(0)
  winnerCount  Int              @default(0)
  error        String?
  logJson      String           @default("[]")
  startedAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  finishedAt   DateTime?
  listings     TrackedListing[]

  @@index([workspaceId, startedAt])
  @@index([status, updatedAt])
}

model TrackedListing {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  huntId            String?
  hunt              Hunt?          @relation(fields: [huntId], references: [id], onDelete: SetNull)
  /// Legacy numeric eBay item id, or "tp-…" for Terapeak rows with no live listing.
  ebayItemId        String
  /// Browse id (v1|legacy|variation) used for getItems; null when not trackable.
  browseItemId      String?
  title             String
  url               String
  imageUrl          String?
  priceMinor        Int
  shippingMinor     Int?
  currency          String         @default("USD")
  keyword           String
  itemCreationDate  DateTime?
  /// Lifetime units sold at the latest snapshot (Browse estimatedSoldQuantity).
  lifetimeSold      Int?
  sold30d           Int?
  /// ESTIMATED | PROJECTED | VERIFIED
  demandTier        String         @default("ESTIMATED")
  /// browse_tracker | terapeak
  demandSource      String         @default("browse_tracker")
  avgSoldPriceMinor Int?
  lastSnapshotAt    DateTime?
  sourcedAt         DateTime?
  sourceError       String?
  active            Boolean        @default(true)
  endedReason       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  snapshots         SoldSnapshot[]
  sources           SourceMatch[]

  @@unique([workspaceId, ebayItemId])
  @@index([workspaceId, active])
  @@index([active, lastSnapshotAt])
}

model SoldSnapshot {
  id           String         @id @default(cuid())
  listingId    String
  listing      TrackedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lifetimeSold Int
  capturedAt   DateTime       @default(now())

  @@index([listingId, capturedAt])
}

model SourceMatch {
  id                String         @id @default(cuid())
  listingId         String
  listing           TrackedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rank              Int
  aeProductId       String
  title             String
  url               String
  imageUrl          String?
  priceMinor        Int
  shippingMinor     Int
  shippingEstimated Boolean        @default(true)
  rating            Float
  reviewCount       Int
  orderCount        Int
  matchConfidence   Int
  matchReasonsJson  String         @default("[]")
  totalCostMinor    Int
  feesMinor         Int
  netProfitMinor    Int
  marginPct         Float
  checkedAt         DateTime       @default(now())

  @@index([listingId, rank])
}

/// Resume cursor for the daily snapshot cron (single row, id = "snapshot").
model CronState {
  id        String   @id
  cursor    String?
  runAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}
