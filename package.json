{
  "name": "ebay-automation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./src/lib/providers/register-ort-loader.mjs' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--import ./src/lib/providers/register-ort-loader.mjs' next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "poc": "NODE_OPTIONS='--import ./src/lib/providers/register-ort-loader.mjs' tsx scripts/poc-run.ts",
    "aliexpress:probe": "tsx scripts/aliexpress-probe.ts",
    "aliexpress:advanced-probe": "tsx scripts/aliexpress-advanced-probe.ts",
    "mcp": "tsx mcp/server.ts",
    "worker:tick": "NODE_OPTIONS='--import ./src/lib/providers/register-ort-loader.mjs' tsx scripts/scheduler-tick.ts",
    "visual:probe": "NODE_OPTIONS='--import ./src/lib/providers/register-ort-loader.mjs' tsx scripts/probe-visual-match.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
