    "@prisma/client": "^6.19.0",
    "date-fns": "^4.4.0",
    "googleapis": "^173.0.0",
    "nanoid": "^6.0.0",
    "next": "15.5.21",
    "onnxruntime-node": "^1.24.3",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
