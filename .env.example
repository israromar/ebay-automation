# Copy to .env and fill values. Never commit real secrets.

# Supabase Postgres (Prisma)
# Dashboard → Project Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL   = Direct / session connection (port 5432) for migrations
DATABASE_URL="postgresql://postgres.iizsdqqfmqfiogxhnwaq:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.iizsdqqfmqfiogxhnwaq:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Supabase JS (not required for Prisma server routes)
NEXT_PUBLIC_SUPABASE_URL="https://iizsdqqfmqfiogxhnwaq.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# eBay Browse API (optional — fixtures used when empty)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace Insights sold history (Limited Release). Default: try when credentials exist.
# Set to false to skip Insights probes entirely.
EBAY_INSIGHTS_ENABLED=
# Operator-triggered purchase-history page fetch (HTTP → Playwright). Default on; set false to disable.
EBAY_PURCHASE_HISTORY_FETCH_ENABLED=true
# Optional logged-in eBay Cookie header (e.g. from browser DevTools). Needed when purchase history requires sign-in.
# EBAY_PURCHASE_HISTORY_COOKIE=

# AliExpress Open Platform (optional — manual fixtures used in MVP)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Requires Affiliate Image Search permission (separate from Advanced API). Keep false until granted.
ALIEXPRESS_IMAGE_SEARCH_ENABLED=false
# Advanced Affiliates API (smart match + hot products). Defaults on unless set to false.
ALIEXPRESS_SMARTMATCH_ENABLED=true
ALIEXPRESS_HOTPRODUCT_ENABLED=true
ALIEXPRESS_APP_SIGNATURE=

# Google Sheets export (optional — CSV always available)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=

# Internal MCP
RESEARCH_API_BASE=http://127.0.0.1:3000
RESEARCH_MCP_ALLOW_WRITES=false
