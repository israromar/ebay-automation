# Copy to .env and fill values. Never commit real secrets.

# ── Database: Supabase Postgres (Prisma) ─────────────────────────────
# Dashboard → Project Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL   = Direct / session connection (port 5432) for migrations
DATABASE_URL="postgresql://postgres.iizsdqqfmqfiogxhnwaq:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.iizsdqqfmqfiogxhnwaq:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── eBay Browse API (required) ───────────────────────────────────────
# developer.ebay.com → Application Keys → Production keyset (client credentials grant).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: EBAY_US (default). EBAY_API_BASE_URL=https://api.sandbox.ebay.com for sandbox keys.
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_API_BASE_URL=
# Batch getItems (20 items/call) is limited to approved Buy API partners. Standard keysets get
# 403 and the app falls back to one getItem call per listing automatically. Set false to skip the probe.
# EBAY_GET_ITEMS_BATCH=false
# Listings per keyword whose sold count is read, in best-match order (default 200 with batch, 100 without).
# EBAY_DETAILS_PER_KEYWORD=100

# ── AliExpress Affiliate API (required) ──────────────────────────────
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_APP_SIGNATURE=
# Advanced Affiliate API extras (on by default; set false if your app key lacks them)
ALIEXPRESS_SMARTMATCH_ENABLED=true
ALIEXPRESS_HOTPRODUCT_ENABLED=true
# Needs the separate image-search permission. Keep false until granted.
ALIEXPRESS_IMAGE_SEARCH_ENABLED=false

# ── Daily sold-snapshot tracker (required for PROJECTED / VERIFIED demand) ──
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/snapshot.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Auth: Supabase, invite-only ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://iizsdqqfmqfiogxhnwaq.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed to use the app
ALLOWED_EMAILS=you@example.com
# Local single-user mode: skip login and use one default workspace
# AUTH_DISABLED=true

# Soft cap: hunts + Terapeak imports per workspace per rolling 24h (default 30)
MAX_HUNTS_PER_DAY=30
